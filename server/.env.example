# Copie este arquivo para server/.env e preencha com valores reais.
# NUNCA versionar o .env (já está no .gitignore).

# Conta administrativa (definida só aqui — não existe cadastro de admin pelo sistema).
ADMIN_USERNAME=
# Gere com: npm run hash-password -- "sua-senha-aqui" (dentro da pasta server/)
ADMIN_PASSWORD_HASH=
# Chave de acesso exclusiva do administrador — diferente da senha, e diferente da
# ANTHROPIC_API_KEY abaixo. Use uma string longa e aleatória.
ADMIN_ACCESS_KEY=

# Chave da API da Anthropic — só usada no backend, nunca chega ao navegador. Opcional: sem
# ela, o sistema funciona normalmente exceto a leitura de fotos/PDFs digitalizados.
ANTHROPIC_API_KEY=

# Segredo usado para assinar o cookie de sessão. Defina um valor fixo (string longa e
# aleatória) em produção — sem isso, todas as sessões são invalidadas a cada reinício do
# servidor.
SESSION_SECRET=

# Opcionais (têm valor padrão se omitidos):
# PORT=3000
# NODE_ENV=production
# SESSION_MAX_AGE_MINUTES=30
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# Pasta onde fica o banco de dados (usuários/logs/sessões). Sem essa variável, usa
# server/data (padrão, bom para uso local). Em produção com disco persistente (ex.: Render,
# ver render.yaml), aponte para o caminho do disco montado — assim os dados sobrevivem a cada
# novo deploy.
# DATA_DIR=/var/data
